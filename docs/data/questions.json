            "Educación",
            "Finanzas y seguros",
            "Hospedaje y alimentación",
            "Información y comunicación",
            "Inmuebles",
            "Manufactura",
            "Minería y canteras",
            "Otros servicios",
            "Salud",
            "Servicios de agua, saneamiento",
            "Transporte y logística"
